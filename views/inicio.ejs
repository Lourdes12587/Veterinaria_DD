          <img src="/resources/img/WhatsApp%20Image%202023-03-23%20at%2020.39.34.jpeg" alt="Perro cliente" />
          <img src="/resources/img/WhatsApp%20Image%202023-01-17%20at%2014.18.22.jpeg" alt="Mascota cliente" />
          <img src="/resources/img/WhatsApp%20Image%202023-03-23%20at%2020.38.19.jpeg" alt="Perro cuidado por DogDreams" />
          <img src="/resources/img/IMG-20200426-WA0013.jpg" alt="" aria-hidden="true" />
          <img src="/resources/img/IMG-20200426-WA0015.jpg" alt="" aria-hidden="true" />
          <img src="/resources/img/IMG-20200619-WA0033.jpg" alt="" aria-hidden="true" />
          <img src="/resources/img/WhatsApp%20Image%202023-03-23%20at%2020.39.34.jpeg" alt="" aria-hidden="true" />
          <img src="/resources/img/WhatsApp%20Image%202023-01-17%20at%2014.18.22.jpeg" alt="" aria-hidden="true" />
          <img src="/resources/img/WhatsApp%20Image%202023-03-23%20at%2020.38.19.jpeg" alt="" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section" id="contacto">
    <div class="container contact-card">
      <div class="contact-copy">
        <p class="eyebrow">Contacto</p>
        <h2>Coordinemos el próximo cuidado de tu mascota.</h2>
        <p>
          Escribinos por WhatsApp y contanos qué servicio necesitás, edad, tamaño y fecha ideal.
        </p>
        <a href="https://wa.me/5492616857811" target="_blank" rel="noopener">
          <i class="fa-brands fa-whatsapp"></i> +54 9 261 685 7811
        </a>
        <a href="mailto:dogdreamshotel@outlook.com">
          <i class="fa-solid fa-envelope"></i> dogdreamshotel@outlook.com
        </a>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Zizzias%20699%20Godoy%20Cruz%20Mendoza"
          target="_blank"
          rel="noopener"
        >
          <i class="fa-solid fa-location-dot"></i> Zizzias 699, Godoy Cruz, Mendoza
        </a>
      </div>

      <form class="contact-form" id="contactForm" autocomplete="off">
        <input type="text" id="nombre" name="nombre" placeholder="Ingresa tu nombre" required />

        <input type="email" id="email" name="email" placeholder="tu@email.com" required />

        <textarea id="mensaje" name="mensaje" rows="5" placeholder="Contanos qué necesita tu mascota" required></textarea>

        <button type="submit">Enviar mensaje</button>
      </form>
    </div>
  </section>
</main>

<script>
  const contactForm = document.getElementById("contactForm");
  const whatsappPhone = "5492616857811";

  contactForm.addEventListener("submit", function (event) {
    event.preventDefault();

    if (!contactForm.checkValidity()) {
      contactForm.reportValidity();
      return;
    }

    const nombre = document.getElementById("nombre").value.trim();
    const email = document.getElementById("email").value.trim();
    const mensaje = document.getElementById("mensaje").value.trim();
    const texto = `Hola DogDreams, soy ${nombre}. Mi email es ${email}. ${mensaje}`;

    window.open(`https://wa.me/${whatsappPhone}?text=${encodeURIComponent(texto)}`, "_blank");
  });
</script>

