# Copia este archivo como env/.env y rellena los valores.
# env/.env está en .gitignore: nunca subas claves reales al repositorio.

# --- Servidor ---
PORT=4000
# Negocio de la demo: nombre del archivo en config/negocios/ (sin .json)
NEGOCIO=dog-dd
# URL pública de la web, para los enlaces de los emails (sin barra final)
URL_PUBLICA=http://localhost:4000

# --- MySQL (usuario "agenda" creado con db/schema.sql, no root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agenda
DB_USER=agenda
DB_PASS=

# --- Tokens de cambiar/cancelar ---
# Secreto largo y aleatorio. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambias, los enlaces de los emails ya enviados dejan de funcionar.
TOKEN_PEPPER=

# --- Email (Resend) ---
# Vacío: los emails se imprimen en la consola en lugar de enviarse.
RESEND_API_KEY=
# Remitente verificado en Resend, ej. Dog DD <citas@tudominio.com>
EMAIL_FROM=

# --- Avisos al negocio (n8n) ---
# Vacío: no se envía ningún aviso.
N8N_WEBHOOK_URL=
# Se envía en la cabecera x-webhook-secret
N8N_WEBHOOK_SECRET=

# --- Google Calendar ---
# Ruta al JSON de la cuenta de servicio, FUERA del repositorio.
# Vacío: la agenda funciona sin calendario (sin bloqueos ni eventos).
GOOGLE_SA_KEY_FILE=
