<%
  const img = (name) => "/resources/img/" + encodeURIComponent(name);
  const whatsapp = "https://wa.me/";

  const servicios = [
    {
      id: "hotel",
      nombre: "Hotel",
      frase: "hotel",
      detalle: "Noches y fines de semana",
      texto: "Estancias cuando necesitas viajar. Duermen dentro de la casa, en camas y mantas, nunca en una jaula.",
      foto: "adistramiento.jpg",
      alt: "Bulldog francés negro mirando hacia arriba",
    },
    {
      id: "guarderia",
      nombre: "Guardería",
      frase: "guardería",
      detalle: "Por día",
      texto: "Jornadas de juego en el patio, piscina en verano, siesta a la sombra y alguien mirando todo el tiempo.",
      foto: "guarderia.jpg",
      alt: "Perro tricolor recostado sobre un fondo amarillo",
    },
    {
      id: "peluqueria",
      nombre: "Peluquería y spa",
      frase: "una cita de peluquería y spa",
      detalle: "Baño, corte e higiene",
      texto: "Baño, corte, higiene y tratamientos pensados para cada raza, tamaño y tipo de pelo.",
      foto: "peluqueria.jpg",
      alt: "Perro envuelto en una toalla azul después del baño",
    },
    {
      id: "veterinaria",
      nombre: "Veterinaria",
      frase: "una cita de veterinaria",
      detalle: "Consultas y controles",
      texto: "Consultas, orientación preventiva y seguimiento del bienestar diario de tu perro.",
      foto: "veterinaria-sin-texto.jpg",
      pos: "100% 50%",
      alt: "Cachorro de weimaraner mirando a la cámara",
    },
    {
      id: "colegio",
      nombre: "Colegio",
      frase: "una plaza en el colegio",
      detalle: "Cachorros y adultos",
      texto: "Socialización, aprendizaje y acompañamiento para perros jóvenes y adultos.",
      foto: "colegiales.jpg",
      alt: "Bulldog francés sentado sobre un fondo rosa",
    },
  ];
%>
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Dog DD: hotel, guardería, peluquería, veterinaria y colegio canino sin jaulas en Barcelona."
    />
    <title>Dog DD | Hotel y spa canino en Barcelona</title>
    <script>document.documentElement.classList.add("js");</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Barlow:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/resources/css/inicio.css" />
  </head>
  <body>
    <main id="inicio">
      <!-- Hero: tarjeta amarilla sobre un huésped dormido -->
      <section class="hero" aria-label="Dog DD">
        <div class="hero__stage">
          <div class="hero__photo">
            <img
              src="<%= img('Black-dog-and-black-background-look_5120x2880.jpg') %>"
              alt="Perro negro de perfil sobre fondo negro"
              width="5120"
              height="2880"
            />
          </div>

          <div class="hero__card" data-hero-card>
            <h1 class="hero__title" data-rise style="--i: 0">
              <span>Dog</span>
              <span>DD</span>
            </h1>

            <div class="hero__body">
              <p class="hero__facts" data-rise style="--i: 1">
                Hotel, guardería y spa canino<br />
                Sin jaulas, en una casa con patio
              </p>
              <p class="hero__line" data-rise style="--i: 2">
                Todo lo que tu perro sueña, mientras tú no estás.
              </p>
            </div>

            <div class="hero__foot" data-rise style="--i: 3">
              <p class="small">Barcelona</p>
              <a class="button button--dark" href="<%= whatsapp %>" target="_blank" rel="noopener">
                Reservar por WhatsApp
              </a>
              <nav class="hero__nav" aria-label="Secciones">
                <a class="link" href="#servicios">Servicios</a>
                <a class="link" href="#reservar">Reservar</a>
                <a class="link" href="#contacto">Contacto</a>
              </nav>
            </div>
          </div>
        </div>
      </section>

      <!-- Intro: sin jaulas -->
      <section class="intro" aria-label="Sin jaulas">
        <div class="intro__pin">
          <p class="intro__statement" data-reveal>
            Aquí no hay jaulas. Duermen en camas, mantas y almohadones, como en casa.
          </p>
          <p class="intro__note muted" data-reveal style="--d: 1">
            Cada huésped tiene su sitio dentro de la casa y su rutina de siempre: horarios de comida,
            paseos y siesta.
          </p>
        </div>
      </section>

      <!-- Servicios: foto fija, lista activa -->
      <section class="services" id="servicios" aria-labelledby="servicios-titulo">
        <div class="services__frame" aria-hidden="true">
          <% servicios.forEach((s, i) => { %>
            <img
              class="<%= i === 0 ? 'is-on' : '' %>"
              data-frame="<%= s.id %>"
              style="object-position: <%= s.pos || '50% 50%' %>"
              src="<%= img(s.foto) %>"
              alt=""
              loading="lazy"
            />
          <% }) %>
        </div>

        <div class="services__list">
          <h2 class="head" id="servicios-titulo" data-reveal>Lo que hacemos</h2>
          <ul class="services__rows">
            <% servicios.forEach((s, i) => { %>
              <li class="row<%= i === 0 ? ' is-active' : '' %>" data-row="<%= s.id %>" data-reveal style="--d: <%= i %>">
                <button class="row__head" type="button" aria-expanded="<%= i === 0 %>" aria-controls="desc-<%= s.id %>">
                  <span class="row__name"><%= s.nombre %></span>
                  <span class="row__detail"><%= s.detalle %></span>
                </button>
                <div class="row__panel" id="desc-<%= s.id %>">
                  <div>
                    <div class="row__inline"><img style="object-position: <%= s.pos || '50% 50%' %>" src="<%= img(s.foto) %>" alt="<%= s.alt %>" loading="lazy" /></div>
                    <p><%= s.texto %></p>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </section>

      <!-- Cómo reservar: un verbo por pantalla -->
      <section class="steps" aria-labelledby="pasos-titulo">
        <h2 class="sr-only" id="pasos-titulo">Cómo reservar</h2>
        <ol class="steps__list">
          <li class="step">
            <div class="step__pin"><h3 class="step__verb">Escribe</h3></div>
            <p class="step__text">Cuéntanos por WhatsApp qué servicio buscas, las fechas y cómo es tu perro.</p>
          </li>
          <li class="step">
            <div class="step__pin"><h3 class="step__verb">Tráelo</h3></div>
            <p class="step__text">Lo recibimos en casa, con su manta o su juguete si los tiene.</p>
          </li>
          <li class="step">
            <div class="step__pin"><h3 class="step__verb">Búscalo</h3></div>
            <p class="step__text">Vuelve a casa limpio, cansado de jugar y bien dormido.</p>
          </li>
        </ol>
      </section>

      <!-- Reserva: agenda con cita previa (peluquería y veterinaria) -->
      <% const r = reserva; const v = r.valores || {}; %>
      <section class="compose" id="reservar" aria-labelledby="reservar-titulo" data-agenda>
        <script type="application/json" id="agenda-datos"><%- JSON.stringify({ slug: negocio.slug, zona: negocio.zonaHoraria, servicios: negocio.servicios, profesionales: negocio.profesionales.map(({ id, nombre, servicios }) => ({ id, nombre, servicios })) }).replace(/</g, "\u003c") %></script>
        <div class="compose__controls">
          <h2 class="head" id="reservar-titulo" data-reveal>Pide cita</h2>
          <p class="compose__intro" data-reveal style="--d: 1">
            Peluquería y veterinaria con cita previa. Elige el servicio, el día y la hora: la cita queda confirmada al momento.
          </p>

          <p class="compose__aviso" role="alert" data-aviso <%= r.error ? '' : 'hidden' %>><%= r.error || '' %></p>

          <!-- Qué, con quién y cuándo. Sin JavaScript, "Ver horas" recarga la página con lo elegido. -->
          <form class="compose__form" method="get" action="/#reservar" data-seleccion data-reveal style="--d: 2">
            <fieldset>
              <legend>Servicio</legend>
              <div class="choices">
                <% r.servicios.forEach((s) => { %>
                  <label class="choice">
                    <input type="radio" name="servicio" value="<%= s.id %>" <%= s.id === r.seleccion.servicio ? 'checked' : '' %> />
                    <span><%= s.nombre %> · <%= s.minutos %> min · <%= s.precio %></span>
                  </label>
                <% }) %>
              </div>
            </fieldset>

            <fieldset>
              <legend>Profesional</legend>
              <div class="choices" data-profesionales>
                <label class="choice">
                  <input type="radio" name="profesional" value="cualquiera" <%= r.seleccion.profesional === 'cualquiera' ? 'checked' : '' %> />
                  <span>Cualquiera</span>
                </label>
                <% r.profesionales.forEach((p) => { %>
                  <label class="choice">
                    <input type="radio" name="profesional" value="<%= p.id %>" <%= p.id === r.seleccion.profesional ? 'checked' : '' %> />
                    <span><%= p.nombre %></span>
                  </label>
                <% }) %>
              </div>
            </fieldset>

            <fieldset>
              <legend>Día</legend>
              <div class="choices" data-dias>
                <% r.dias.forEach((d) => { %>
                  <label class="choice">
                    <input type="radio" name="fecha" value="<%= d.fecha %>" <%= d.disponible ? '' : 'disabled' %> <%= d.fecha === r.seleccion.fecha ? 'checked' : '' %> />
                    <span><%= d.etiqueta %></span>
                  </label>
                <% }) %>
              </div>
              <p class="small muted" data-sin-dias <%= !r.caida && r.dias.length && !r.seleccion.fecha ? '' : 'hidden' %>>No quedan días libres para este servicio. Prueba con otro profesional o llámanos al <%= negocio.telefono %>.</p>
            </fieldset>

            <button class="button" type="submit" data-sinjs>Ver horas</button>
          </form>

          <!-- Hora y datos. Es un POST normal: funciona aunque falle el JavaScript. -->
          <form class="compose__form" method="post" action="/reservar#reservar" id="form-reserva" data-reserva>
            <input type="hidden" name="servicio" value="<%= r.seleccion.servicio %>" />
            <input type="hidden" name="profesional" value="<%= r.seleccion.profesional %>" />

            <fieldset>
              <legend>Hora</legend>
              <div class="choices" data-horas>
                <% r.huecos.forEach((h) => { %>
                  <label class="choice">
                    <input type="radio" name="inicio" value="<%= h.inicio %>" required <%= h.inicio === r.seleccion.inicio ? 'checked' : '' %> />
                    <span><%= h.hora %></span>
                  </label>
                <% }) %>
              </div>
              <p class="small muted" data-sin-horas <%= r.seleccion.fecha && !r.huecos.length ? '' : 'hidden' %>>Ese día ya no quedan horas. Elige otro día.</p>
            </fieldset>

            <fieldset>
              <legend>Tus datos</legend>
              <div class="fields">
                <label class="field-label">
                  Nombre
                  <input class="field" type="text" name="nombre" required minlength="2" maxlength="120" autocomplete="name" value="<%= v.nombre || '' %>" />
                </label>
                <label class="field-label">
                  Teléfono
                  <input class="field" type="tel" name="telefono" required pattern="\+?[0-9 \(\)\-]{9,20}" maxlength="20" autocomplete="tel" placeholder="600 000 000" value="<%= v.telefono || '' %>" />
                </label>
                <label class="field-label">
                  Email
                  <input class="field" type="email" name="email" required maxlength="254" autocomplete="email" value="<%= v.email || '' %>" />
                </label>
              </div>
            </fieldset>

            <label class="field-label">
              Nota (opcional): nombre y raza de tu mascota
              <textarea class="field" name="nota" rows="2" maxlength="500" placeholder="Mora, caniche"><%= v.nota || '' %></textarea>
              <span class="small">No escribas aquí información médica.</span>
            </label>

            <label class="compose__check">
              <input type="checkbox" name="privacidad" value="si" required <%= v.privacidad ? 'checked' : '' %> />
              <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</span>
            </label>

            <!-- Trampa para bots: oculto a personas y lectores de pantalla. -->
            <div class="sr-only" aria-hidden="true">
              <label>No rellenes este campo <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
            </div>
          </form>
        </div>

        <div class="compose__preview" data-reveal style="--d: 1">
          <p class="compose__message" data-resumen aria-live="polite"><%= r.resumen %></p>
          <button class="button" type="submit" form="form-reserva" data-confirmar <%= r.caida ? 'disabled' : '' %>>Confirmar cita</button>
        </div>
      </section>

      <!-- Contacto: WhatsApp como tipografía -->
      <section class="contact" id="contacto" aria-label="Contacto">
        <p class="contact__lead" data-reveal>
          Escríbenos para reservar, preguntar un precio o venir a conocer la casa.
        </p>
        <p class="contact__mail" data-reveal style="--d: 1">
          <a href="<%= whatsapp %>" target="_blank" rel="noopener">WhatsApp</a>
        </p>
      </section>
    </main>

    <footer class="footer">
      <p class="muted">Hotel y spa canino en Barcelona</p>
      <nav class="footer__links" aria-label="Pie de página">
        <a class="link" href="#servicios">Servicios</a>
        <a class="link" href="#reservar">Reservar</a>
        <a class="link" href="#contacto">Contacto</a>
      </nav>
      <p class="muted footer__year">© <%= new Date().getFullYear() %> Dog DD</p>
    </footer>

    <script src="/resources/js/inicio.js" defer></script>
  </body>
</html>
