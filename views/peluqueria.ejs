<%- include('partials/head') %>

  <%- include('partials/header') %>

  <link rel="stylesheet" href="/resources/css/peluqueria.css">

  <body class="body">
    <!--TITULO-->
    <main class="container">
      <div class="left__container">
        <div class="left__text">
          <h1>PELUQUERIA & SPA</h1>
          <h3>¡Carga el turno para tu mascota!</h3>
        </div>
      </div>
      <!--FORMULARIO-->
      <form id="form" novalidate>
        <div class="form__inputs">
          <div class="form__top">
            <div class="form__field">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" />
              <small></small>
            </div>
          </div>
          <div class="form__top">
            <div class="form__field">
              <label for="edad">Edad</label>
              <input type="number" id="edad" name="edad" />
              <small></small>
            </div>
          </div>
          <div class="form__top">
            <div class="form__field">
              <label for="raza">Raza</label>
              <input type="text" id="raza" name="raza" />
              <small></small>
            </div>
          </div>
          <!--CARD RAZA-->
          <div class="card text-bg-dark mb-3" style="width: 18rem" >
            <img
              src="../imagen/SERVICIOS/peluqueria.jpg"
              class="card-img-top"
              alt="..."
            />
            <div class="card-body">
              <h5 class="card-title">¡IMPORTANTE!</h5>
              <p class="card-text">
                NO BRINDAMOS SERVICIO A LAS RAZAS:
              </p>
              <ul>
                <li>PITBULL</li>
                <li>STARFFORDSHIRE BULL TERRIER</li>
                <li>DOBERMAN</li>
                <li>PRESA CANARIO</li>
                <li>ROTTWEILER</li>
                <li>BULLMASTIFF</li>
                <li>AKITA</li>
                <li>BULL TIERRIER</li>
                <li>PASTOR ALEMAN</li>
                <li>GRAN DANES</li>
                <li>FILA BRASILIERO</li>
                <li>MASTIN TIBETANO</li>
                <li>DOGO ARGENTINO</li>
                <li>BULLY KUTTA</li>
                <li>TOSA INU</li>
                <li>BULLDOG</li>
                <li>CHUW CHOW</li>
                <li>CHIHUAHUA</li>
                <li>CANE CORSO / MASTIN ITALIANO</li>
                <li>DOGO BURDEOS</li>
              </ul>
            </div>
          </div>
          <!--DATOS TURNO-->
          <div class="form__mid">
            <div class="form__field">
              <label for="date">Fecha</label>
              <!-- VAMOS A SETEAR MIN / MAX / VALUE del input date EN JS para que no se pueda elegir cualquier fecha -->
              <input type="date" name="date" id="date" />
              <small></small>
            </div>
            <div class="form__field">
              <label for="hour">Hora</label>
              <!-- SETEAMOS MIN MAX VALUE Y STEP EN LA CLASE
            QUEREMOS QUE SOLO SE PUEDA RESERVAR UN ESPACIO ENTRE LAS 8 AM Y LAS 19 PM.
            EL VALUE ES EL VALOR POR DEFECTO QUE APARECERÁ EN EL FORM
            STEP ES 1800 PARA QUE AVANCE DE A MEDIA HORA , ESTA EN SEGUNDOS, EQUIVALE A MEDIA HORA YA QUE 3600 SEGUNDOS ES UNA HORA.
            -->
              <input
                type="time"
                name="hour"
                id="hour"
                min="08:00"
                max="19:30"
                value="08:00"
                step="1800"
              />
              <small></small>
            </div>
          </div>
          <div class="form__bot">
            <div class="form__field">
              <label for="email">Correo electronico</label>
              <input type="email" name="email" id="email" />
              <small></small>
            </div>
            <div class="form__field">
              <label for="phone">Telefono</label>
              <input type="tel" name="phone" id="phone" />
              <small></small>
            </div>
          </div>
        </div>
        <button type="submit">Enviar</button>
      </form>
      <!-- Separador -->
      <div class="mid__container"></div>
      <!-- Cards -->
      <div class="right__container" id="cards-container">
        <!-- ACA VAN LOS TURNOS -->

